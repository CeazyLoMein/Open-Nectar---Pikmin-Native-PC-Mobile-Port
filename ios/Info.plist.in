<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleIdentifier</key><string>@NECTAR_IOS_BUNDLE_ID@</string>
  <key>CFBundleDisplayName</key><string>@NECTAR_IOS_LABEL@</string>
  <key>CFBundleName</key><string>@NECTAR_IOS_LABEL@</string>
  <key>CFBundleIcons</key><dict>
    <key>CFBundlePrimaryIcon</key><dict>
      <key>CFBundleIconFiles</key><array>
        <string>Icon-60</string><string>Icon-40</string><string>Icon-29</string>
      </array>
      <key>UIPrerenderedIcon</key><true/>
    </dict>
  </dict>
  <key>CFBundleExecutable</key><string>@NECTAR_IOS_EXECUTABLE@</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.1.0</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>MinimumOSVersion</key><string>15.0</string>
  <key>LSRequiresIPhoneOS</key><true/>
  <key>UIRequiresFullScreen</key><true/>
  <!-- Allow ProMotion rates; the player still selects the game FPS mode. -->
  <key>CADisableMinimumFrameDurationOnPhone</key><true/>
  <key>UILaunchScreen</key><dict/>
  <key>UIApplicationSceneManifest</key><dict>
    <key>UIApplicationSupportsMultipleScenes</key><false/>
    <key>UISceneConfigurations</key><dict>
      <key>UIWindowSceneSessionRoleApplication</key><array><dict>
        <key>UISceneConfigurationName</key><string>NectarGame</string>
        <key>UISceneClassName</key><string>UIWindowScene</string>
        <key>UISceneDelegateClassName</key><string>NectarSDLSceneDelegate</string>
      </dict></array>
    </dict>
  </dict>
  <key>UIStatusBarHidden</key><true/>
  <key>UIFileSharingEnabled</key><true/>
  <key>LSSupportsOpeningDocumentsInPlace</key><true/>
  <key>UISupportedInterfaceOrientations</key><array>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
</dict></plist>
