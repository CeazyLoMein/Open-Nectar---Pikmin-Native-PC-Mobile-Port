# Metadata shared by the real iOS build and host packaging tests.
set(NECTAR_IOS_VARIANT "standard" CACHE STRING "standard or solo-test (P1 only)")
set_property(CACHE NECTAR_IOS_VARIANT PROPERTY STRINGS standard solo-test)
if(NOT NECTAR_IOS_VARIANT STREQUAL "standard" AND NOT NECTAR_IOS_VARIANT STREQUAL "solo-test")
    message(FATAL_ERROR "Unknown NECTAR_IOS_VARIANT")
endif()
if(NECTAR_IOS_VARIANT STREQUAL "solo-test" AND NOT NECTAR_IOS_GAME STREQUAL "pikmin1")
    message(FATAL_ERROR "solo-test is supported only for pikmin1")
endif()
set(NECTAR_IOS_EXECUTABLE "Nectar-${NECTAR_IOS_GAME}")
if(NECTAR_IOS_GAME STREQUAL "pikmin1")
    set(NECTAR_IOS_LABEL "Open Nectar Pikmin 1")
else()
    set(NECTAR_IOS_LABEL "Open Nectar Pikmin 2")
endif()
set(NECTAR_IOS_BUNDLE_ID "org.opennectar.experimental.${NECTAR_IOS_GAME}")
if(NECTAR_IOS_VARIANT STREQUAL "solo-test")
    set(NECTAR_IOS_EXECUTABLE "Nectar-pikmin1-solo-test")
    set(NECTAR_IOS_LABEL "P1 Solo Test")
    set(NECTAR_IOS_BUNDLE_ID "org.opennectar.experimental.pikmin1.solotest")
endif()
